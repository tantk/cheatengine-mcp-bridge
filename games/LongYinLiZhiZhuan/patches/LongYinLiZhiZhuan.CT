              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end
local wd = _getWorldData()
if not wd then error("WorldData null") end
local forces = readQword(wd + 0x48)
if not forces or forces == 0 then error("Forces null") end
local forceItems = readQword(forces + 0x10)
local forceCount = readInteger(forces + 0x18)

local input = InputQuery("Faction Contribution", "Set your contribution to ALL other factions to:", "999")
if not input then print("[OutContrib] Cancelled"); return end
local newVal = tonumber(input)
if not newVal then print("[OutContrib] Invalid number"); return end

local changed = 0
for i = 0, forceCount - 1 do
  local fd = readQword(forceItems + 0x20 + i * 8)
  if fd and fd ~= 0 then
    writeFloat(fd + 0x170, newVal * 1.0)
    changed = changed + 1
  end
end
print(string.format("[OutContrib] Set contribution to %d factions = %.0f", changed, newVal))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
print("[OutContrib] (values remain as set)")
