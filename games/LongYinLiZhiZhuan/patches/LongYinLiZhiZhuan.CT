-- Populate equipment dropdown based on selected type
local function refreshEqItems()
  cmbEqItem.Items.clear()
  local dbInfo = equipDBs[cmbEqType.ItemIndex + 1]
  if dbInfo.staticItems then
    -- Accessories/decorations: fixed type list, no database needed
    for i, name in ipairs(dbInfo.staticItems) do
      cmbEqItem.Items.add(string.format("[%d] %s", i - 1, name))
    end
    cmbEqItem.ItemIndex = 0
    return
  end
  if not S.ready or not S.gdc then
    cmbEqItem.Items.add("(请先连接游戏)")
    cmbEqItem.ItemIndex = 0
    return
  end
  local db = readQword(S.gdc + dbInfo.off)
  if not db or db == 0 then return end
  local items = readQword(db + 0x10)
  local count = readInteger(db + 0x18)
  for i = 0, count - 1 do
    local t = readQword(items + 0x20 + i * 8)
    if t and t ~= 0 then
      local nameObj = readQword(t + 0x20)
      if nameObj and nameObj ~= 0 then
        local nl = readInteger(nameObj + 0x10)
        if nl and nl > 0 and nl < 50 then
          local tname = readString(nameObj + 0x14, nl * 2, true)
          cmbEqItem.Items.add(string.format("[%d] %s", i, tname))
        end
      end
    end
  end
  if cmbEqItem.Items.Count > 0 then cmbEqItem.ItemIndex = 0 end
end
cmbEqType.OnChange = function() refreshEqItems() end
_refreshEqItemsFn = refreshEqItems

