        <CheatEntry>
          <ID>20</ID>
          <Description>"--- Talents (TianFu) ---"</Description>
          <GroupHeader>1</GroupHeader>
          <Color>008000</Color>
          <CheatEntries>
            <CheatEntry>
              <ID>300</ID>
              <Description>"Max Talent Slots (9 -> 99)"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end
local c = _il2cpp_init()
if not c:ensure("hd", "HeroData") then error("HeroData not loaded yet - try again") end
local targetAddr = _findMethodAddr(c.hd.klass, "GetMaxTagNum")
if not targetAddr or targetAddr == 0 then error("GetMaxTagNum not found") end

-- GetMaxTagNum has 3 return paths:
--   Path A: mov eax, 0A  (B8 0A 00 00 00) — when [hero+0x58]!=0 (most common)
--   Path B: mov eax, 09  (B8 09 00 00 00) — when config bool is set
--   Path C: add eax, 09  (83 C0 09)       — base+9 calculated path
-- All end with epilogue: 48 83 C4 20 5B C3  (add rsp,20; pop rbx; ret)
-- We must patch ALL three to take effect.
_talentCapPatches = {}
local newCap = 0x63  -- 99

for offset = 0, 511 do
  local b = readBytes(targetAddr + offset, 1)
  -- Pattern A/B: B8 XX 00 00 00 48 83 C4 20 5B C3  (mov eax, imm32; epilogue)
  if b == 0xB8 then
    local ok = true
    for ci, cv in ipairs({nil, 0x00, 0x00, 0x00, 0x48, 0x83, 0xC4, 0x20, 0x5B, 0xC3}) do
      if cv then
        if readBytes(targetAddr + offset + ci, 1) ~= cv then ok = false; break end
      end
    end
    if ok then
      local pAddr = targetAddr + offset + 1
      local orig = readBytes(pAddr, 1)
      table.insert(_talentCapPatches, {addr=pAddr, orig=orig})
      writeBytes(pAddr, newCap)
      print(string.format("[TalentCap] Patched mov eax,0x%02X -> 0x%02X at +%d", orig, newCap, offset))
    end
  end
  -- Pattern C: 83 C0 XX 48 83 C4 20 5B C3  (add eax, imm8; epilogue)
  if b == 0x83 and readBytes(targetAddr + offset + 1, 1) == 0xC0 then
    local ok = true
    for ci, cv in ipairs({nil, nil, nil, 0x48, 0x83, 0xC4, 0x20, 0x5B, 0xC3}) do
      if cv then
        if readBytes(targetAddr + offset + ci - 1, 1) ~= cv then ok = false; break end
      end
    end
    if ok then
      local pAddr = targetAddr + offset + 2
      local orig = readBytes(pAddr, 1)
      table.insert(_talentCapPatches, {addr=pAddr, orig=orig})
      writeBytes(pAddr, newCap)
      print(string.format("[TalentCap] Patched add eax,0x%02X -> 0x%02X at +%d", orig, newCap, offset))
    end
  end
end

if #_talentCapPatches == 0 then
  error("No patch sites found in GetMaxTagNum!")
else
  print(string.format("[TalentCap] Patched %d return paths (all -> max 99)", #_talentCapPatches))
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _talentCapPatches then
  for _, p in ipairs(_talentCapPatches) do
    writeBytes(p.addr, p.orig)
  end
  print(string.format("[TalentCap] Restored %d patches", #_talentCapPatches))
  _talentCapPatches = nil
end
{$asm}
              </AssemblerScript>
            </CheatEntry>
