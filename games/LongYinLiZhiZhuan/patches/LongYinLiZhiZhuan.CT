Y = Y + 32

lbl = createLabel(frm); lbl.Left = 10; lbl.Top = Y; lbl.Caption = "Horse"
lbl.Font.Size = 9; lbl.Font.Style = "fsBold"; Y = Y + 20
local cmbHr = createComboBox(frm); cmbHr.Left = 10; cmbHr.Top = Y; cmbHr.Width = 320
for _, h in ipairs(horseDB) do cmbHr.Items.add(string.format("[%d] %s", h[1], h[2])) end; cmbHr.ItemIndex = 0
local btnHr = createButton(frm); btnHr.Left = 400; btnHr.Top = Y - 2; btnHr.Width = 100; btnHr.Height = 24
btnHr.Caption = "Add Horse"
btnHr.OnClick = function()
  if not S.ready then setStatus("Connect first!", 0x0000FF); return end
  setStatus("Adding...", 0x008080)
  local ok, msg = addHorse(horseDB[cmbHr.ItemIndex + 1][1])
  setStatus(ok and ("Added: " .. msg) or ("ERR: " .. msg), ok and 0x008000 or 0x0000FF)
end
Y = Y + 32

lbl = createLabel(frm); lbl.Left = 10; lbl.Top = Y; lbl.Caption = "Equipment (Weapon/Armor/Helmet/Shoes)"
lbl.Font.Size = 9; lbl.Font.Style = "fsBold"; Y = Y + 20
local cmbEqType = createComboBox(frm); cmbEqType.Left = 10; cmbEqType.Top = Y; cmbEqType.Width = 80
for _, e in ipairs(equipDBs) do cmbEqType.Items.add(e.name) end; cmbEqType.ItemIndex = 0
local cmbEqItem = createComboBox(frm); cmbEqItem.Left = 100; cmbEqItem.Top = Y; cmbEqItem.Width = 160
local lblEqLv = createLabel(frm); lblEqLv.Left = 270; lblEqLv.Top = Y + 3; lblEqLv.Caption = "Rarity:"
local cmbEqRare = createComboBox(frm); cmbEqRare.Left = 310; cmbEqRare.Top = Y; cmbEqRare.Width = 90
cmbEqRare.Items.add("0 White"); cmbEqRare.Items.add("1 Normal"); cmbEqRare.Items.add("2 Good")
cmbEqRare.Items.add("3 Excellent"); cmbEqRare.Items.add("4 Perfect"); cmbEqRare.Items.add("5 Legendary")
cmbEqRare.ItemIndex = 5

-- Populate equipment dropdown based on selected type
local function refreshEqItems()
  cmbEqItem.Items.clear()
  local dbInfo = equipDBs[cmbEqType.ItemIndex + 1]
  if not S.ready or not S.gdc then
    cmbEqItem.Items.add("(Connect first)")
    cmbEqItem.ItemIndex = 0
    return
  end
  local db = readQword(S.gdc + dbInfo.off)
  if not db or db == 0 then return end
  local items = readQword(db + 0x10)
  local count = readInteger(db + 0x18)
  for i = 0, count - 1 do
    local t = readQword(items + 0x20 + i * 8)
    if t and t ~= 0 then
      local nameObj = readQword(t + 0x20)
      if nameObj and nameObj ~= 0 then
        local nl = readInteger(nameObj + 0x10)
        if nl and nl > 0 and nl < 50 then
          local tname = readString(nameObj + 0x14, nl * 2, true)
          cmbEqItem.Items.add(string.format("[%d] %s", i, tname))
        end
      end
    end
  end
  if cmbEqItem.Items.Count > 0 then cmbEqItem.ItemIndex = 0 end
end
cmbEqType.OnChange = function() refreshEqItems() end
_refreshEqItemsFn = refreshEqItems

local btnEq = createButton(frm); btnEq.Left = 410; btnEq.Top = Y - 2; btnEq.Width = 90; btnEq.Height = 24
btnEq.Caption = "Add Equip"
btnEq.OnClick = function()
  if not S.ready then setStatus("Connect first!", 0x0000FF); return end
  local dbInfo = equipDBs[cmbEqType.ItemIndex + 1]
  -- Parse real DB index from dropdown text "[35] 软弓" → 35
  local selText = cmbEqItem.Items[cmbEqItem.ItemIndex]
  local idx = tonumber(selText and selText:match("^%[(%d+)%]")) or cmbEqItem.ItemIndex
  local rareLv = cmbEqRare.ItemIndex  -- 0-5 maps directly to rarity
  setStatus(string.format("Gen %s [%d] rarity=%d", dbInfo.name, idx, rareLv), 0x008080)
  local ok, msg = addEquipGenerated(dbInfo.genRVA, idx, rareLv, 1.0)
  if not ok then
    setStatus("Generator failed: " .. tostring(msg), 0x0000FF)
  end
  setStatus(ok and ("Added: " .. msg) or ("ERR: " .. msg), ok and 0x008000 or 0x0000FF)
end
Y = Y + 32

lbl = createLabel(frm); lbl.Left = 10; lbl.Top = Y; lbl.Caption = "Medicine (Main Thread)"
lbl.Font.Size = 9; lbl.Font.Style = "fsBold"; Y = Y + 20
local cmbMed = createComboBox(frm); cmbMed.Left = 10; cmbMed.Top = Y; cmbMed.Width = 320
for _, m in ipairs(medDB) do cmbMed.Items.add(string.format("[%d] %s", m[1], m[2])) end; cmbMed.ItemIndex = 0
local btnMed = createButton(frm); btnMed.Left = 400; btnMed.Top = Y - 2; btnMed.Width = 100; btnMed.Height = 24
btnMed.Caption = "Add Medicine"
btnMed.OnClick = function()
  if not S.ready then setStatus("Connect first!", 0x0000FF); return end
  setStatus("Adding...", 0x008080)
  local ok, msg = addMedFood(medDB[cmbMed.ItemIndex + 1][1], 0x110)
  setStatus(ok and ("Added: " .. msg) or ("ERR: " .. msg), ok and 0x008000 or 0x0000FF)
end
Y = Y + 32

lbl = createLabel(frm); lbl.Left = 10; lbl.Top = Y; lbl.Caption = "Food (Main Thread)"
lbl.Font.Size = 9; lbl.Font.Style = "fsBold"; Y = Y + 20
local cmbFd = createComboBox(frm); cmbFd.Left = 10; cmbFd.Top = Y; cmbFd.Width = 320
for _, f in ipairs(foodDB) do cmbFd.Items.add(string.format("[%d] %s", f[1], f[2])) end; cmbFd.ItemIndex = 0
local btnFd = createButton(frm); btnFd.Left = 400; btnFd.Top = Y - 2; btnFd.Width = 100; btnFd.Height = 24
btnFd.Caption = "Add Food"
btnFd.OnClick = function()
  if not S.ready then setStatus("Connect first!", 0x0000FF); return end
  setStatus("Adding...", 0x008080)
  local ok, msg = addMedFood(foodDB[cmbFd.ItemIndex + 1][1], 0x118)
  setStatus(ok and ("Added: " .. msg) or ("ERR: " .. msg), ok and 0x008000 or 0x0000FF)
end

frm.Show()
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

-- 1. Close debug log + GUI
if _logFile then pcall(function() _logFile:close() end); _logFile = nil end
if _itemAdderForm then _itemAdderForm.destroy(); _itemAdderForm = nil end

-- 2. Disarm command gate + clear pending commands before unhook
local ok_cb, cmdBufAddr = pcall(getAddress, "cmdBuf")
if ok_cb and cmdBufAddr and cmdBufAddr ~= 0 then
  writeInteger(cmdBufAddr + 0x38, 0)  -- disable command processing
  writeInteger(cmdBufAddr, 0)          -- clear any pending command
  writeInteger(cmdBufAddr + 0x04, 0)   -- clear status
end

-- 3. Unhook GameController.Update
if _ia_harmonyPtrSlot and _ia_origChainTarget then
  -- Restore Harmony's original pointer
  writeQword(_ia_harmonyPtrSlot, _ia_origChainTarget)
  print("[ItemAdder] Restored Harmony trampoline pointer")
  _ia_harmonyPtrSlot = nil
  _ia_origChainTarget = nil
  sleep(100)
elseif _ia_directPatch and _ia_directPatchAddr and _ia_directPatchOrigBytes then
  -- Restore original code bytes (no-Harmony direct patch)
  local n = _ia_patchLen or #_ia_directPatchOrigBytes
  for i = 1, n do writeBytes(_ia_directPatchAddr + i - 1, _ia_directPatchOrigBytes[i]) end
  print("[ItemAdder] Restored original Update code bytes")
  _ia_directPatch = nil; _ia_patchLen = nil
  _ia_directPatchAddr = nil
  _ia_directPatchOrigBytes = nil
  if _ia_relayCode then deAlloc(_ia_relayCode); _ia_relayCode = nil end
  sleep(100)
end

-- 3. Dealloc + unregister symbols (pcall-guarded)
local function tryDealloc(name)
  local ok, addr = pcall(getAddress, name)
  if not ok or not addr or addr == 0 then return end
  pcall(autoAssemble, string.format("unregistersymbol(%s)", name))
  pcall(autoAssemble, string.format("dealloc(%s)", name))
end
tryDealloc("wkCode")
tryDealloc("wkData")
tryDealloc("wkStr")
tryDealloc("cmdBuf")
tryDealloc("hookCode")
tryDealloc("origUpdatePtr")

-- 4. Reset state
_ia_hookInstalled = nil
{$asm}
]]></AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <LuaScript><![CDATA[
-- ============================================================
-- Shared IL2CPP Init (replaces LaunchMonoDataCollector)
-- Called once per session, results cached globally.
-- ============================================================
function _il2cpp_init()
  if _il2cppCache then return _il2cppCache end

  -- Minimal il2cpp calls using snapshot offsets (f7.8)
  -- Static field offsets from snapshot — hardcoded to avoid field enumeration
  local OFFSETS = {
    gc_inst = 0x0,      -- GameController._instance in static data
    gdc_inst = 0x20,    -- GameDataController._instance in static data
    gdc_tagBase = 0x198, -- heroTagDataBase (instance field)
    gd_skill = 0x130,   -- GlobalData.MaxSkillNum in static data
    bc_inst = 0x50,     -- BattleController._instance in static data
  }

  -- Step 1: Get Assembly-CSharp image (3 calls: domain, assemblies, image)
  local domain = executeCodeEx(0, nil, getAddress("GameAssembly.il2cpp_domain_get"))
  if not domain or domain == 0 then error("il2cpp_domain_get failed - is game loaded?") end
  local sizePtr = allocateMemory(8); writeQword(sizePtr, 0)
  local arr = executeCodeEx(0, nil, getAddress("GameAssembly.il2cpp_domain_get_assemblies"), domain, sizePtr)
  local count = readInteger(sizePtr); deAlloc(sizePtr)
  -- Assembly-CSharp is always last
  local asmPtr = readQword(arr + (count - 1) * 8)
  local img = executeCodeEx(0, nil, getAddress("GameAssembly.il2cpp_assembly_get_image"), asmPtr)

  -- Step 2: Find classes (1 call each, reuse allocated strings)
  local cfn = getAddress("GameAssembly.il2cpp_class_from_name")
  local ns = allocateMemory(16); writeString(ns, "")
  local cn = allocateMemory(64)
  local function findClass(name)
    writeString(cn, name)
    local k = executeCodeEx(0, nil, cfn, img, ns, cn)
    return k ~= 0 and k or nil
  end

  -- Only GameController is required. Others are resolved lazily (IL2CPP race condition).
  local gc = findClass("GameController")
  if not gc then error("GameController not found - is game loaded?") end
  local gdc = findClass("GameDataController")
  local gd  = findClass("GlobalData")
  local hd  = findClass("HeroData")
  local bc  = findClass("BattleController")
  deAlloc(ns); deAlloc(cn)

  local function klassData(k, instOff)
    if not k then return nil end
    return {klass=k, static=readQword(k+0xB8), instOff=instOff}
  end

  _il2cppCache = {
    img = img, _cfn = cfn,
    gc  = klassData(gc, OFFSETS.gc_inst),
    gdc = gdc and {klass=gdc, static=readQword(gdc+0xB8), instOff=OFFSETS.gdc_inst, tagBaseOff=OFFSETS.gdc_tagBase} or nil,
    gd  = gd and {klass=gd, static=readQword(gd+0xB8), skillOff=OFFSETS.gd_skill} or nil,
    hd  = hd and {klass=hd} or nil,
    bc  = bc and {klass=bc, static=readQword(bc+0xB8), instOff=OFFSETS.bc_inst} or nil,
  }

  -- Lazy resolver for classes not yet initialized
  _il2cppCache.findClass = function(name)
    local ns2 = allocateMemory(16); writeString(ns2, "")
    local cn2 = allocateMemory(64); writeString(cn2, name)
    local k = executeCodeEx(0, nil, _il2cppCache._cfn, _il2cppCache.img, ns2, cn2)
    deAlloc(ns2); deAlloc(cn2)
    return k ~= 0 and k or nil
  end

  -- Try to resolve missing classes on next access
  _il2cppCache.ensure = function(self, field, className, instOff)
    if self[field] then return self[field] end
    local k = self.findClass(className)
    if k then
      if instOff then
        self[field] = {klass=k, static=readQword(k+0xB8), instOff=instOff}
      else
        self[field] = {klass=k}
      end
    end
    return self[field]
  end

  local found = 0
  for _, k in ipairs({gc, gdc, gd, hd, bc}) do if k then found = found + 1 end end
  print(string.format("[il2cpp] Init OK (%d/5 classes found)", found))
  return _il2cppCache
end

function _getHero()
  local c = _il2cpp_init()
  local inst = readQword(c.gc.static + c.gc.instOff)
  if not inst or inst == 0 then
    -- Cache is stale (game restarted), clear and retry once
    _il2cppCache = nil
    c = _il2cpp_init()
    inst = readQword(c.gc.static + c.gc.instOff)
    if not inst or inst == 0 then return nil, "GameController._instance null (load a save first)" end
  end
  local wd = readQword(inst + 0x20); if not wd or wd == 0 then return nil, "WorldData null" end
  local hl = readQword(wd + 0x50);  if not hl or hl == 0 then return nil, "HerosList null" end
  local ip = readQword(hl + 0x10);  if not ip or ip == 0 then return nil, "HerosList items null" end
  local h = readQword(ip + 0x20);   if not h or h == 0 then return nil, "Hero not found" end
  return h, inst
end

function _getWorldData()
  local c = _il2cpp_init()
  local inst = readQword(c.gc.static + c.gc.instOff)
  if not inst or inst == 0 then
    _il2cppCache = nil
    c = _il2cpp_init()
    inst = readQword(c.gc.static + c.gc.instOff)
    if not inst or inst == 0 then return nil, "GameController._instance null" end
  end
  local wd = readQword(inst + 0x20); if not wd or wd == 0 then return nil, "WorldData null" end
  return wd
end

function _findMethodAddr(klass, methodName, paramCount)
  -- Single il2cpp call instead of iterating all methods
  local gmfn = getAddress("GameAssembly.il2cpp_class_get_method_from_name")
  local nm = allocateMemory(64); writeString(nm, methodName)
  local mi = executeCodeEx(0, nil, gmfn, klass, nm, paramCount or 0)
  deAlloc(nm)
  if not mi or mi == 0 then return nil end
  return readQword(mi) -- methodPointer at offset 0
end

function _il2cpp_reset()
  _il2cppCache = nil
  print("[il2cpp] Cache cleared - will re-init on next cheat activation")
end
  ]]></LuaScript>
</CheatTable>
