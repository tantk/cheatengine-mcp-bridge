local frm = createForm(false)
_itemAdderForm = frm
frm.Caption = "LongYinLiZhiZhuan Item Adder v4 (Full Main Thread)"
frm.Width = 520; frm.Height = 600
frm.Position = "poScreenCenter"; frm.BorderStyle = "bsSingle"

local Y = 10
local lblStatus = createLabel(frm)
lblStatus.Left = 10; lblStatus.Top = 9999; lblStatus.Width = 500
lblStatus.Caption = "请先点击连接游戏 [Click Connect first]"; lblStatus.Font.Color = 0x808080
local function setStatus(msg, color) lblStatus.Caption = msg; lblStatus.Font.Color = color or 0 end
local function safeClick(fn)
  return function()
    local ok, err = pcall(fn)
    if not ok then setStatus("ERR: " .. tostring(err), 0x0000FF) end
  end
end

local btnConn = createButton(frm)
btnConn.Left = 10; btnConn.Top = Y; btnConn.Width = 130; btnConn.Height = 28
btnConn.Caption = "连接游戏 [Connect]"
btnConn.OnClick = function()
  -- Check game is attached first to avoid scary CE allocation errors
  local pid = getOpenedProcessID()
  if not pid or pid == 0 then
    setStatus("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]", 0x0000FF)
    return
  end
  -- Force refresh symbols in case process changed
  _il2cppCache = nil
  reinitializeSymbolhandler()
  local ga = getAddress("GameAssembly.dll")
  if not ga or ga == 0 then
    setStatus("找不到游戏 - 请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]", 0x0000FF)
    return
  end
  setStatus("连接中... [Connecting...]", 0x008080)
  local pcallOk, discoverOk, discoverMsg = pcall(discover)
  if not pcallOk then
    setStatus("ERR: " .. tostring(discoverOk), 0x0000FF)
  elseif discoverOk then
    setStatus(discoverMsg, 0x008000)
    pcall(function() _refreshEqItemsFn() end)
  else
    setStatus("ERR: " .. tostring(discoverMsg), 0x0000FF)
  end
end
