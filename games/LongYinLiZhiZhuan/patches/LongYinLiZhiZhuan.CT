              <Description>"瞬间完成当前研究 [Instant Research]"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
local hero = _getHero()
if not hero then error("Hero not found") end
local playerForceID = readInteger(hero + 0x84)
local wd = _getWorldData()
if not wd then error("WorldData null") end
local forces = readQword(wd + 0x48)
local forceItems = readQword(forces + 0x10)
local forceCount = readInteger(forces + 0x18)
local playerFD = nil
for i = 0, forceCount - 1 do
  local fd = readQword(forceItems + 0x20 + i * 8)
  if fd and fd ~= 0 and readInteger(fd + 0x10) == playerForceID then playerFD = fd; break end
end
if not playerFD then error("Player ForceData not found") end

local activeID = readInteger(playerFD + 0x128)
if activeID < 0 then error("No active research (nowResearchTech < 0)") end

local tld = readQword(playerFD + 0x130)
local tldItems = readQword(tld + 0x10)
local tldCnt = readInteger(tld + 0x18)

local found = false
for i = 0, tldCnt - 1 do
  local e = readQword(tldItems + 0x20 + i * 8)
  if e and e ~= 0 and readInteger(e + 0x10) == activeID then
    local oldLv = readInteger(e + 0x14)
    local oldPct = readFloat(e + 0x18)
    -- Complete: increment level, reset progress, clear active research
    writeInteger(e + 0x14, oldLv + 1)
    writeFloat(e + 0x18, 0.0)
    writeInteger(playerFD + 0x128, -1)
    print(string.format("[Research] Tech %d: lv %d -> %d (was %.0f%%, now complete and cleared)", activeID, oldLv, oldLv + 1, oldPct * 100))
    found = true
    break
  end
end
if not found then print("[Research] Active tech " .. activeID .. " not found in techLvData") end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
print("[Research] (toggle again to complete next research)")
{$asm}
