      <Color>800080</Color>
      <CheatEntries>

        <CheatEntry>
          <ID>901</ID>
          <Description>"创建天赋槽位 [Creation Talent Slots]"</Description>
          <Color>000000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end

_checkGameAlive()

local input = InputQuery("Creation Talent Slots", "Enter max talent slots (default 5, max 99):", "10")
if not input then return end
local maxSlots = tonumber(input)
if not maxSlots or maxSlots < 1 or maxSlots > 99 then error("Invalid value (1-99)") end

-- Find Assembly-CSharp image by scanning all assemblies
local getDomain = getAddress("GameAssembly.il2cpp_domain_get")
local getAssemblies = getAddress("GameAssembly.il2cpp_domain_get_assemblies")
local getImage = getAddress("GameAssembly.il2cpp_assembly_get_image")
local classFromName = getAddress("GameAssembly.il2cpp_class_from_name")
local gmfn = getAddress("GameAssembly.il2cpp_class_get_method_from_name")

if not getDomain or getDomain == 0 or not getAssemblies or getAssemblies == 0 or
   not getImage or getImage == 0 or not classFromName or classFromName == 0 or
   not gmfn or gmfn == 0 then
  error("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]")
end

local domain = executeCodeEx(0, nil, getDomain)
if not domain or domain == 0 then error("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]") end
local sizePtr = allocateMemory(8)
local asmList = executeCodeEx(0, nil, getAssemblies, domain, sizePtr)
local asmCount = readInteger(sizePtr)
deAlloc(sizePtr)
if not asmList or asmList == 0 or not asmCount or asmCount == 0 then
  error("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]")
end

local klass = nil
local ns = allocateMemory(16); writeString(ns, "")
local cn = allocateMemory(64); writeString(cn, "StartMenuController")
for i = 0, asmCount - 1 do
  local asm = readQword(asmList + i * 8)
  if asm and asm ~= 0 then
    local img = executeCodeEx(0, nil, getImage, asm)
    if img and img ~= 0 then
      local k = executeCodeEx(0, nil, classFromName, img, ns, cn)
      if k and k ~= 0 then klass = k; break end
    end
  end
end
deAlloc(ns); deAlloc(cn)
if not klass then error("请先进入角色创建界面 [Enter character creation screen first]") end

-- Use method iterator (get_method_from_name fails for some classes)
local getMethods = getAddress("GameAssembly.il2cpp_class_get_methods")
local getMethodName = getAddress("GameAssembly.il2cpp_method_get_name")
local iter2 = allocateMemory(8); writeQword(iter2, 0)
local chooseAddr, refreshAddr
for i = 1, 80 do
  local mi = executeCodeEx(0, nil, getMethods, klass, iter2)
  if not mi or mi == 0 then break end
  local np = executeCodeEx(0, nil, getMethodName, mi)
  local mname = np and readString(np, 64) or ""
  if mname == "StartChooseTagClicked" then chooseAddr = readQword(mi) end
  if mname == "RefreshTagMenu" then refreshAddr = readQword(mi) end
end
deAlloc(iter2)
if not chooseAddr then error("StartChooseTagClicked not found") end
if not refreshAddr then error("RefreshTagMenu not found") end

_ccTagSlotOrig = {}
local patched = 0

-- Patch 1: StartChooseTagClicked — find 83 78 18 05 (cmp [rax+18], 5)
for off = 0, 0x400 do
  local a = chooseAddr + off
  if readBytes(a, 1) == 0x83 and readBytes(a+2, 1) == 0x18 and readBytes(a+3, 1) == 0x05 then
    _ccTagSlotOrig[1] = {addr = a+3, val = 0x05}
    writeBytes(a+3, maxSlots)
    patched = patched + 1
    break
  end
end

-- Patch 2: RefreshTagMenu — find 83 F8 05 (cmp eax, 5)
for off = 0, 0x1000 do
  local a = refreshAddr + off
  if readBytes(a, 1) == 0x83 and readBytes(a+1, 1) == 0xF8 and readBytes(a+2, 1) == 0x05 then
    _ccTagSlotOrig[2] = {addr = a+2, val = 0x05}
    writeBytes(a+2, maxSlots)
    patched = patched + 1
    break
  end
end

if patched < 2 then
  for _, o in ipairs(_ccTagSlotOrig) do writeBytes(o.addr, o.val) end
  error("Only patched " .. patched .. "/2 locations")
end

print(string.format("[Character Creation] Talent slot limit: 5 -> %d", maxSlots))

[DISABLE]
{$lua}
if syntaxcheck then return end
if _ccTagSlotOrig then
  for _, o in ipairs(_ccTagSlotOrig) do
    writeBytes(o.addr, o.val)
  end
  _ccTagSlotOrig = nil
  print("[Character Creation] Talent slot limit restored to 5")
end
]]></AssemblerScript>
        </CheatEntry>

        <CheatEntry>
          <ID>902</ID>
          <Description>"创建天赋点 [Creation Talent Points]"</Description>
          <Color>000000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
_checkGameAlive()

local getDomain = getAddress("GameAssembly.il2cpp_domain_get")
local getAssemblies = getAddress("GameAssembly.il2cpp_domain_get_assemblies")
local getImage = getAddress("GameAssembly.il2cpp_assembly_get_image")
local classFromName = getAddress("GameAssembly.il2cpp_class_from_name")

if not getDomain or getDomain == 0 or not getAssemblies or getAssemblies == 0 or
   not getImage or getImage == 0 or not classFromName or classFromName == 0 then
  error("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]")
end

local domain = executeCodeEx(0, nil, getDomain)
if not domain or domain == 0 then error("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]") end
local sizePtr = allocateMemory(8)
local asmList = executeCodeEx(0, nil, getAssemblies, domain, sizePtr)
local asmCount = readInteger(sizePtr)
deAlloc(sizePtr)
if not asmList or asmList == 0 or not asmCount or asmCount == 0 then
  error("请关闭CE重新打开并连接游戏 [Close CE, reopen, attach to game]")
end

local sgsc = nil
local ns = allocateMemory(16); writeString(ns, "")
local cn = allocateMemory(64); writeString(cn, "StartGameSettingController")
for i = 0, asmCount - 1 do
  local asm = readQword(asmList + i * 8)
  if asm and asm ~= 0 then
    local img = executeCodeEx(0, nil, getImage, asm)
    if img and img ~= 0 then
      local k = executeCodeEx(0, nil, classFromName, img, ns, cn)
      if k and k ~= 0 then sgsc = k; break end
    end
  end
end
deAlloc(ns); deAlloc(cn)
if not sgsc then error("请先进入角色创建界面 [Enter character creation screen first]") end

local sf = readQword(sgsc + 0xB8)
local inst = readQword(sf)
if not inst or inst == 0 then error("StartGameSettingController instance null") end

local player = readQword(inst + 0x18)
if not player or player == 0 then error("请先进入角色创建界面 [Enter character creation screen first]") end

local current = readFloat(player + 0x35C)
local input = InputQuery("Creation Talent Points", string.format("Current: %.0f. Enter new value:", current), "999")
if not input then return end
local val = tonumber(input)
if not val or val < 0 then error("Invalid value") end

writeFloat(player + 0x35C, val)
print(string.format("[Character Creation] Talent points: %.0f -> %.0f", current, val))

[DISABLE]
{$lua}
if syntaxcheck then return end
print("[Character Creation] Talent points cheat disabled (value already set)")
]]></AssemblerScript>
        </CheatEntry>

        <CheatEntry>
          <ID>903</ID>
          <Description>"分配点数 [Distribute Points]"</Description>
          <Color>000000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
_checkGameAlive()

-- Find StartMenuController instance
local getDomain = getAddress("GameAssembly.il2cpp_domain_get")
local getAssemblies = getAddress("GameAssembly.il2cpp_domain_get_assemblies")
local getImage = getAddress("GameAssembly.il2cpp_assembly_get_image")
local classFromName = getAddress("GameAssembly.il2cpp_class_from_name")

if not getDomain or getDomain == 0 then error("请先连接游戏进程") end
local domain = executeCodeEx(0, nil, getDomain)
if not domain or domain == 0 then error("请先连接游戏进程") end
local sizePtr = allocateMemory(8)
local asmList = executeCodeEx(0, nil, getAssemblies, domain, sizePtr)
local asmCount = readInteger(sizePtr)
deAlloc(sizePtr)

local smc = nil
local ns = allocateMemory(16); writeString(ns, "")
local cn = allocateMemory(64); writeString(cn, "StartMenuController")
for i = 0, asmCount - 1 do
  local asm = readQword(asmList + i * 8)
  if asm and asm ~= 0 then
    local img = executeCodeEx(0, nil, getImage, asm)
    if img and img ~= 0 then
      local k = executeCodeEx(0, nil, classFromName, img, ns, cn)
      if k and k ~= 0 then
        local sf = readQword(k + 0xB8)
        smc = readQword(sf)
        break
      end
    end
  end
end
deAlloc(ns); deAlloc(cn)
if not smc or smc == 0 then error("请先进入角色创建界面 [Enter character creation screen first]") end

local curAttri = readInteger(smc + 0x80) or 0
local curFight = readInteger(smc + 0x84) or 0
local curLiving = readInteger(smc + 0x88) or 0

local input = InputQuery("Distribute Points",
  string.format("Attribute pts (current: %d):", curAttri), "999")
if not input then return end
local newAttri = tonumber(input)
if not newAttri then error("Invalid number") end

local input2 = InputQuery("Distribute Points",
  string.format("Fight skill pts (current: %d):", curFight), "999")
if not input2 then return end
local newFight = tonumber(input2)
if not newFight then error("Invalid number") end

local input3 = InputQuery("Distribute Points",
  string.format("Living skill pts (current: %d):", curLiving), "999")
if not input3 then return end
local newLiving = tonumber(input3)
if not newLiving then error("Invalid number") end

writeInteger(smc + 0x80, newAttri)
writeInteger(smc + 0x84, newFight)
writeInteger(smc + 0x88, newLiving)

print(string.format("[Character Creation] Points: attri %d->%d, fight %d->%d, living %d->%d",
  curAttri, newAttri, curFight, newFight, curLiving, newLiving))

[DISABLE]
{$lua}
if syntaxcheck then return end
]]></AssemblerScript>
        </CheatEntry>

      </CheatEntries>
    </CheatEntry>

    <CheatEntry>
      <ID>95</ID>
      <Description>"--- 世界事件 (开发中) [World Events (WIP)] ---"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
      <GroupHeader>1</GroupHeader>
      <Color>804000</Color>
      <CheatEntries>

        <CheatEntry>
          <ID>951</ID>
          <Description>"武学奇才事件 [Martial Prodigy Event] (WIP - reveal only)"</Description>
          <Color>000000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
_checkGameAlive()

local c = _il2cppCache
if not c then _il2cpp_init(); c = _il2cppCache end
if not c then error("IL2CPP init failed") end

local gc = readQword(c.gc.static + c.gc.instOff)
if not gc or gc == 0 then
  _il2cppCache = nil
  _il2cpp_init()
  c = _il2cppCache
  if c then gc = readQword(c.gc.static + c.gc.instOff) end
  if not gc or gc == 0 then error("请先加载存档 [Load a save first]") end
end
local wd = readQword(gc + 0x20)
local we = readQword(wd + 0x80)
local n = readInteger(we + 0x18)
local it = readQword(we + 0x10)

-- Find 武学奇才 by checking for FindSpeFollower callback in plotData
local wuxueEvent = nil
for i = 0, n - 1 do
  local ev = readQword(it + 0x20 + i * 8)
  if ev and ev ~= 0 then
    local pd = readQword(ev + 0x70)
    if pd and pd ~= 0 then
      local sp = readQword(pd + 0x40)
      if sp and sp ~= 0 then
        local spCount = readInteger(sp + 0x18)
        if spCount and spCount > 0 then
          local spItems = readQword(sp + 0x10)
          local sp0 = readQword(spItems + 0x20)
          if sp0 and sp0 ~= 0 then
            local choices = readQword(sp0 + 0x38)
            if choices and choices ~= 0 and readInteger(choices + 0x18) > 0 then
              local ch0 = readQword(readQword(choices + 0x10) + 0x20)
              if ch0 and ch0 ~= 0 then
                local callPtr = readQword(ch0 + 0x20)
                if callPtr and callPtr ~= 0 then
                  local len = readInteger(callPtr + 0x10)
                  if len and len > 10 and len < 60 then
                    local bytes = {}
                    for j = 0, len*2-1 do
                      local b = readBytes(callPtr+0x14+j, 1)
                      if b and b>=32 and b<127 then bytes[#bytes+1]=string.char(b) end
                    end
                    if table.concat(bytes):find("FindSpeFollower") then
                      wuxueEvent = ev
                      break
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

local input = InputQuery("Martial Prodigy Event",
  "Difficulty (higher = stronger hero, default 10):", "10")
if not input then return end
local newDiff = tonumber(input)
if not newDiff or newDiff < 1 then error("Invalid difficulty") end

if not wuxueEvent then
  -- Event doesn't exist - call GenerateRandomEvent repeatedly until one spawns
  -- Use cmd=4 slot to call GenerateRandomEvent on main thread
  local cb = getAddress("cmdBuf")
  if not cb or cb == 0 then error("Open Item Adder and Connect first") end
  local base = getAddress("GameAssembly.dll")

  -- Resolve GenerateRandomEvent RVA
  local getMethods = getAddress("GameAssembly.il2cpp_class_get_methods")
  local getMethodName = getAddress("GameAssembly.il2cpp_method_get_name")
  local genRVA = nil
  local iter2 = allocateMemory(8); writeQword(iter2, 0)
  for j = 1, 500 do
    local mi2 = executeCodeEx(0, nil, getMethods, c.gc.klass, iter2)
    if not mi2 or mi2 == 0 then break end
    local np2 = executeCodeEx(0, nil, getMethodName, mi2)
    local mn2 = np2 and readString(np2, 64) or ""
    if mn2 == "GenerateRandomEvent" then genRVA = readQword(mi2) - base; break end
  end
  deAlloc(iter2)
  if not genRVA then error("GenerateRandomEvent not found") end

  -- Clear event cooldowns so the event can spawn again
  local saveRecord = readQword(wd + 0x78)
  local origSRCount = saveRecord and readInteger(saveRecord + 0x18) or 0
  if saveRecord and origSRCount > 0 then
    writeInteger(saveRecord + 0x18, 0)
  end
  -- Also reset lastRandomWorldEventDay
  local origLastDay = readFloat(wd + 0x70)
  writeFloat(wd + 0x70, 0)

  -- Force GenerateRandomEvent to pick 武学奇才 (template index 6)
  -- by temporarily replacing bigMapRandomEventID list with just [6]
  local classFromName2 = getAddress("GameAssembly.il2cpp_class_from_name")
  local ns2 = allocateMemory(16); writeString(ns2, "")
  local cn2 = allocateMemory(64); writeString(cn2, "RandomEventController")
  local recClass = executeCodeEx(0, nil, classFromName2, c.img, ns2, cn2)
  deAlloc(ns2); deAlloc(cn2)
  local recSF = readQword(recClass + 0xB8)
  local recInst = readQword(recSF)
  if not recInst or recInst == 0 then error("RandomEventController not active") end

  local bmIDs = readQword(recInst + 0x30)
  local bmItems = readQword(bmIDs + 0x10)
  local bmCount = readInteger(bmIDs + 0x18)

  -- Save original first entry and count
  local origFirst = readInteger(bmItems + 0x20)
  local origCount = bmCount

  -- Temporarily set list to just [6] (武学奇才 template index)
  writeInteger(bmItems + 0x20, 6)
  writeInteger(bmIDs + 0x18, 1)

  -- Try multiple times with cooldown resets
  local attempts = 3
  for att = 1, attempts do
    -- Call GenerateRandomEvent
    writeInteger(cb + 0x10, 0)
    writeInteger(cb + 0x14, 0)
    writeFloat(cb + 0x18, 0)
    writeQword(cb + 0x68, base + genRVA)
    writeInteger(cb + 0x04, 0)
    writeInteger(cb, 4)
    local elapsed = 0
    while elapsed < 3000 do
      if readInteger(cb + 0x04) ~= 0 then break end
      sleep(16); elapsed = elapsed + 16
    end
    local cmdStatus = readInteger(cb + 0x04)

    -- Check if event was created
    we = readQword(wd + 0x80)
    local newCount = readInteger(we + 0x18)
    print(string.format("[Event] attempt %d: cmd=%d old=%d new=%d", att, cmdStatus, n, newCount))
    if newCount > n then
      it = readQword(we + 0x10)
      wuxueEvent = readQword(it + 0x20 + (newCount - 1) * 8)
      print("[Event] 武学奇才 created!")
      break
    end
    -- Reset n for next attempt
    n = newCount
  end

  -- Restore original list
  writeInteger(bmItems + 0x20, origFirst)
  writeInteger(bmIDs + 0x18, origCount)

  -- Restore cooldowns
  if saveRecord and origSRCount > 0 then
    writeInteger(saveRecord + 0x18, origSRCount)
  end
  writeFloat(wd + 0x70, origLastDay)

  if not wuxueEvent then error("Failed to create event after " .. attempts .. " attempts.") end
end

local curDiff = readFloat(wuxueEvent + 0x64)
writeFloat(wuxueEvent + 0x64, newDiff)
writeBytes(wuxueEvent + 0x58, 1)
writeFloat(wuxueEvent + 0x60, 30.0)

print(string.format("[Event] 武学奇才: difficulty %.0f -> %.0f, revealed, 30 days", curDiff, newDiff))

[DISABLE]
{$lua}
if syntaxcheck then return end
]]></AssemblerScript>
        </CheatEntry>

      </CheatEntries>
    </CheatEntry>

  </CheatEntries>
  <LuaScript><![CDATA[
-- ============================================================
-- Auto-clear stale state when process changes
-- ============================================================
if not _processWatcherInstalled then
  local lastPID = getOpenedProcessID()
  registerFormAddNotification(function(frm)
    -- This fires on various CE events. Check if PID changed.
    local curPID = getOpenedProcessID()
    if curPID ~= lastPID then
      lastPID = curPID
      _il2cppCache = nil
      _itemAdderState = nil
      print("[CT] Process changed — caches cleared")
    end
  end)
  -- Also hook the OpenProcess event directly
  if getMainForm().ProcessLabel then
    local origOnClick = getMainForm().ProcessLabel.OnClick
    local timer = createTimer()
    timer.Interval = 2000
    timer.OnTimer = function()
      local pid = getOpenedProcessID()
      if pid ~= lastPID then
        lastPID = pid
        _il2cppCache = nil
        print("[CT] Process changed (timer) — cache cleared")
      end
    end
    timer.Enabled = true
    _staleCheckTimer = timer
  end
  _processWatcherInstalled = true
end

-- ============================================================
-- Shared IL2CPP Init (replaces LaunchMonoDataCollector)
-- Called once per session, results cached globally.
-- ============================================================
-- All method RVAs are resolved at runtime — no version-specific constants needed

function _checkGameAlive()
  local gaAddr = getAddress("GameAssembly.dll")
  if not gaAddr or gaAddr < 0x100000 then
    error("游戏未运行 [Game not running] - 请重新打开CE连接游戏")
  end
  local testRead = readBytes(gaAddr, 1)
  if not testRead then
    -- Stale CE state — reinitialize symbol list
    reinitializeSymbolhandler()
    gaAddr = getAddress("GameAssembly.dll")
    if not gaAddr or gaAddr < 0x100000 then
      error("CE状态过期 [Stale CE state] - 请关闭CE重新打开")
    end
    testRead = readBytes(gaAddr, 1)
    if not testRead then
      error("CE状态过期 [Stale CE state] - 请关闭CE重新打开")
    end
  end
  return gaAddr
end

function _il2cpp_init()
  -- Check if cache is valid: GA base must match (game restart = new base)
  if _il2cppCache then
    local curGA = getAddress("GameAssembly.dll")
    if curGA and curGA == _il2cppCache._gaBase then return _il2cppCache end
    -- GA base changed = game restarted, clear stale cache
    _il2cppCache = nil
  end

  -- Validate game is alive, auto-fix stale symbols
  local gaAddr = _checkGameAlive()

  -- Validate ALL il2cpp exports upfront to prevent nearby allocation popup
  local exports = {
    domainGet = getAddress("GameAssembly.il2cpp_domain_get"),
    domainGetAsm = getAddress("GameAssembly.il2cpp_domain_get_assemblies"),
    asmGetImage = getAddress("GameAssembly.il2cpp_assembly_get_image"),
    classFromName = getAddress("GameAssembly.il2cpp_class_from_name"),
  }
  for name, addr in pairs(exports) do
    if not addr or addr < 0x100000 then
      error("请先连接游戏并加载存档 [Attach to game and load a save first]")
    end
  end

  local OFFSETS = {
    gc_inst = 0x0,
    gdc_inst = 0x20,
    gdc_tagBase = 0x198,
    gd_skill = 0x130,
    bc_inst = 0x50,
  }

  -- Step 1: Get Assembly-CSharp image (3 calls)
  local domain = executeCodeEx(0, nil, exports.domainGet)
  if not domain or domain == 0 then error("il2cpp_domain_get failed") end
  local sizePtr = allocateMemory(8); writeQword(sizePtr, 0)
  local arr = executeCodeEx(0, nil, exports.domainGetAsm, domain, sizePtr)
  local count = readInteger(sizePtr); deAlloc(sizePtr)
  local asmPtr = readQword(arr + (count - 1) * 8)
  local img = executeCodeEx(0, nil, exports.asmGetImage, asmPtr)

  -- Step 2: Find classes (1 call each)
  local cfn = exports.classFromName
  local ns = allocateMemory(16); writeString(ns, "")
  local cn = allocateMemory(64)
  local function findClass(name)
    writeString(cn, name)
    local k = executeCodeEx(0, nil, cfn, img, ns, cn)
    return k ~= 0 and k or nil
  end

  -- Only GameController is required. Others are resolved lazily (IL2CPP race condition).
  local gc = findClass("GameController")
  if not gc then error("GameController not found - is game loaded?") end
  local gdc = findClass("GameDataController")
  local gd  = findClass("GlobalData")
  local hd  = findClass("HeroData")
  local bc  = findClass("BattleController")
  deAlloc(ns); deAlloc(cn)

  local function klassData(k, instOff)
    if not k then return nil end
    return {klass=k, static=readQword(k+0xB8), instOff=instOff}
  end

  _il2cppCache = {
    _gaBase = gaAddr, img = img, _cfn = cfn,
    gc  = klassData(gc, OFFSETS.gc_inst),
    gdc = gdc and {klass=gdc, static=readQword(gdc+0xB8), instOff=OFFSETS.gdc_inst, tagBaseOff=OFFSETS.gdc_tagBase} or nil,
    gd  = gd and {klass=gd, static=readQword(gd+0xB8), skillOff=OFFSETS.gd_skill} or nil,
    hd  = hd and {klass=hd} or nil,
    bc  = bc and {klass=bc, static=readQword(bc+0xB8), instOff=OFFSETS.bc_inst} or nil,
  }

  -- Lazy resolver for classes not yet initialized
  _il2cppCache.findClass = function(name)
    local ns2 = allocateMemory(16); writeString(ns2, "")
    local cn2 = allocateMemory(64); writeString(cn2, name)
    local k = executeCodeEx(0, nil, _il2cppCache._cfn, _il2cppCache.img, ns2, cn2)
    deAlloc(ns2); deAlloc(cn2)
    return k ~= 0 and k or nil
  end

  -- Try to resolve missing classes on next access
  _il2cppCache.ensure = function(self, field, className, instOff)
    if self[field] then return self[field] end
    local k = self.findClass(className)
    if k then
      if instOff then
        self[field] = {klass=k, static=readQword(k+0xB8), instOff=instOff}
      else
        self[field] = {klass=k}
      end
    end
    return self[field]
  end

  local found = 0
  for _, k in ipairs({gc, gdc, gd, hd, bc}) do if k then found = found + 1 end end

  -- Detect and display game version
  local verStr = "?"
  local fixStr = "?"
  if gd then
    local gdStatic = readQword(gd + 0xB8)
    if gdStatic and gdStatic ~= 0 then
      local vnPtr = readQword(gdStatic + 0x68)
      if vnPtr and vnPtr ~= 0 then
        local nl = readInteger(vnPtr + 0x10)
        if nl and nl > 0 then verStr = readString(vnPtr + 0x14, nl*2, true) or "?" end
      end
      local fnPtr = readQword(gdStatic + 0x70)
      if fnPtr and fnPtr ~= 0 then
        local nl = readInteger(fnPtr + 0x10)
        if nl and nl > 0 then fixStr = readString(fnPtr + 0x14, nl*2, true) or "?" end
      end
    end
  end
  local gaSize = getModuleSize("GameAssembly.dll") or 0
  print(string.format("[龙胤立志传] 版本 %s %s (GA: %d bytes, %d/5 classes)", verStr, fixStr, gaSize, found))

  return _il2cppCache
end

function _isGameRunning()
  local pid = getOpenedProcessID()
  if not pid or pid == 0 then return false end
  -- PID can be stale for dead process — verify by reading memory
  local ga = getAddress("GameAssembly.dll")
  if not ga or ga < 0x100000 then return false end
  local b = readBytes(ga, 1)
  return b ~= nil
end

function _getHero()
  if not _isGameRunning() then return nil, "Game not running" end
  local c = _il2cpp_init()
  local inst = readQword(c.gc.static + c.gc.instOff)
  if not inst or inst == 0 then
    _il2cppCache = nil
    c = _il2cpp_init()
    inst = readQword(c.gc.static + c.gc.instOff)
    if not inst or inst == 0 then return nil, "GameController._instance null (load a save first)" end
  end
  local wd = readQword(inst + 0x20); if not wd or wd == 0 then return nil, "WorldData null" end
  local hl = readQword(wd + 0x50);  if not hl or hl == 0 then return nil, "HerosList null" end
  local ip = readQword(hl + 0x10);  if not ip or ip == 0 then return nil, "HerosList items null" end
  local h = readQword(ip + 0x20);   if not h or h == 0 then return nil, "Hero not found" end
  return h, inst
end

function _getWorldData()
  if not _isGameRunning() then return nil, "Game not running" end
  local c = _il2cpp_init()
  local inst = readQword(c.gc.static + c.gc.instOff)
  if not inst or inst == 0 then
    _il2cppCache = nil
    c = _il2cpp_init()
    inst = readQword(c.gc.static + c.gc.instOff)
    if not inst or inst == 0 then return nil, "GameController._instance null" end
  end
  local wd = readQword(inst + 0x20); if not wd or wd == 0 then return nil, "WorldData null" end
  return wd
end

function _findMethodAddr(klass, methodName, paramCount)
  -- Single il2cpp call instead of iterating all methods
  local gmfn = getAddress("GameAssembly.il2cpp_class_get_method_from_name")
  local nm = allocateMemory(64); writeString(nm, methodName)
  local mi = executeCodeEx(0, nil, gmfn, klass, nm, paramCount or 0)
  deAlloc(nm)
  if not mi or mi == 0 then return nil end
  return readQword(mi) -- methodPointer at offset 0
end

function _il2cpp_reset()
  _il2cppCache = nil
  print("[il2cpp] Cache cleared - will re-init on next cheat activation")
end
  ]]></LuaScript>
</CheatTable>
