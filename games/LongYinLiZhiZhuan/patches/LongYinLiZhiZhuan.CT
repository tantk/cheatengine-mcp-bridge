          <Color>008000</Color>
          <CheatEntries>
            <CheatEntry>
              <ID>1420</ID>
              <Description>"马匹加速 (速度会存档,关闭后恢复) [Horse Speed - saved with game, disable to restore]"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
local hero = _getHero()
if not hero then error("Hero not found") end
local input = InputQuery("Boost Horse Speed", "Enter speed multiplier (2-500, default 100):", "100")
if not input then print("[Travel] Cancelled"); return end
local multi = tonumber(input) or 5
if multi > 500 then multi = 500 end
if multi < 1 then multi = 1 end

-- Boost horse speed directly (hero+0x208=horse ItemData, +0x88=HorseData, +0x14=speed float)
local horseItem = readQword(hero + 0x208)
if not horseItem or horseItem == 0 then error("No horse equipped! Equip a horse first.") end
local hdOff = (_itemAdderState and _itemAdderState.OFF_HORSE) or 0x88
local horseData = readQword(horseItem + hdOff)
if not horseData or horseData == 0 then
  -- Try alternate offset
  hdOff = (hdOff == 0x88) and 0x80 or 0x88
  horseData = readQword(horseItem + hdOff)
end
if not horseData or horseData == 0 then error("Horse has no HorseData") end
local origSpeed = readFloat(horseData + 0x14)
_travelOrig = {addr = horseData + 0x14, val = origSpeed}
writeFloat(horseData + 0x14, origSpeed * multi)
print(string.format("[Travel] Horse speed: %.0f -> %.0f (x%d)", origSpeed, origSpeed * multi, multi))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _travelOrig then
  writeFloat(_travelOrig.addr, _travelOrig.val)
  print(string.format("[Travel] Horse speed restored to %.0f", _travelOrig.val))
  _travelOrig = nil
end
{$asm}
]]></AssemblerScript>
