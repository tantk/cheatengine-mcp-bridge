  local fd = readQword(forceItems + 0x20 + i * 8)
  if fd and fd ~= 0 and readInteger(fd + 0x10) == playerForceID then playerFD = fd; break end
end
if not playerFD then error("Player ForceData not found") end

-- resourceStore at +0x88, resourceStoreMax at +0x90
local rs = readQword(playerFD + 0x88)
local rsItems = readQword(rs + 0x10)
local rsSize = readInteger(rs + 0x18)
local rm = readQword(playerFD + 0x90)
local rmItems = readQword(rm + 0x10)

local resNames = {"Wood", "Ore", "Medicine", "Food", "Poison", "Money"}
local filled = 0
for i = 0, rsSize - 1 do
  local mx = readFloat(rmItems + 0x20 + i * 4)
  writeFloat(rsItems + 0x20 + i * 4, mx)
  local name = resNames[i + 1] or ("Res" .. i)
  print(string.format("[Resource] %s -> %.0f", name, mx))
  filled = filled + 1
end
print(string.format("[Resource] Filled %d resources to max", filled))
