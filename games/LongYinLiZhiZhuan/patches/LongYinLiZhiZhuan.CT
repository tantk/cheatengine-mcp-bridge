        <CheatEntry>
          <ID>20</ID>
          <Description>"--- 天赋 [Talents] ---"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <GroupHeader>1</GroupHeader>
          <Color>008000</Color>
          <CheatEntries>
            <CheatEntry>
              <ID>300</ID>
              <Description>"天赋槽位上限99 [Max Talent Slots]"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end
-- Simple approach: patch GetMaxTagNum to always return 99
-- Replace first bytes with: mov eax,63; ret (B8 63 00 00 00 C3)
-- Much more resilient to game updates than AOB scanning return paths
local c = _il2cpp_init()
if not c:ensure("hd", "HeroData") then error("HeroData not loaded yet - try again") end
local targetAddr = _findMethodAddr(c.hd.klass, "GetMaxTagNum")
if not targetAddr or targetAddr == 0 then error("GetMaxTagNum not found") end

_talentCapPatches = {}
for i = 0, 5 do _talentCapPatches[i+1] = readBytes(targetAddr + i, 1) end
-- mov eax, 99; ret
writeBytes(targetAddr, {0xB8, 0x63, 0x00, 0x00, 0x00, 0xC3})
print(string.format("[TalentCap] GetMaxTagNum patched to return 99 at %X", targetAddr))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _talentCapPatches then
  local c = _il2cpp_init()
  if c:ensure("hd", "HeroData") then
    local addr = _findMethodAddr(c.hd.klass, "GetMaxTagNum")
    if addr then
      for i = 1, #_talentCapPatches do writeBytes(addr + i - 1, _talentCapPatches[i]) end
    end
  end
  print("[TalentCap] Restored original GetMaxTagNum")
  _talentCapPatches = nil
end
{$asm}
              </AssemblerScript>
