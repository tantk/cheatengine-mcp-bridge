              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end
local function getHero() return _getHero() end
local hero, err = getHero()
if not hero then error(err) end
local curFame = readFloat(hero + 0x1C4)
local curBad = readFloat(hero + 0x1C8)
local input = InputQuery("Set Fame", "Current: Fame=" .. string.format("%.0f", curFame) .. " BadFame=" .. string.format("%.0f", curBad) .. ". Enter new Fame (BadFame will be set to 0):", "1000")
if input then
  local val = tonumber(input) or 1000
  writeFloat(hero + 0x1C4, val * 1.0)
  writeFloat(hero + 0x1C8, 0.0)
  print(string.format("[Fame] Set fame=%.0f badFame=0", val))
end
{$asm}

