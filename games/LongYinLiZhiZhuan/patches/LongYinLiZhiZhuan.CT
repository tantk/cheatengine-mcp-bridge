local edtAge = createEdit(frm); edtAge.Left = 160; edtAge.Top = Y; edtAge.Width = 35; edtAge.Text = "0"
local lblLoyal = createLabel(frm); lblLoyal.Left = 200; lblLoyal.Top = Y + 3; lblLoyal.Caption = "Loyal忠诚:"
local edtLoyal = createEdit(frm); edtLoyal.Left = 260; edtLoyal.Top = Y; edtLoyal.Width = 35; edtLoyal.Text = "0"
