-- ============================================================
-- DEBUG LOG
-- ============================================================
local LOG_PATH = os.getenv("TEMP") .. "\\ce_itemadder_debug.log"
local _logFile = nil
local function logOpen()
  _logFile = io.open(LOG_PATH, "w")
  if _logFile then _logFile:write("=== ItemAdder v3 Debug Log ===\n") end
end
local function log(msg)
  if _logFile then _logFile:write(os.date("%H:%M:%S ") .. tostring(msg) .. "\n"); _logFile:flush() end
end
local function logClose()
  if _logFile then _logFile:close(); _logFile = nil end
end
local function toHex(addr)
  if not addr then return "nil" end
  return string.format("%X", addr)
end

-- ============================================================
-- DATABASES FOR DROPDOWNS
-- ============================================================
local skillDB = {
  {279,"元始天功 内功"},{280,"飘飘欲仙 轻功"},{281,"虎啸龙吟 绝技"},
  {282,"照影神拳 拳掌"},{283,"诛仙剑法 剑法"},{284,"九州风雷刀 刀法"},
  {285,"大闹天宫棍 长兵"},{286,"碧海潮生曲 奇门"},{287,"多情飞刀 射术"},
