btnGenHero.Caption = "生成 Hero"
local function boostList(heroData, baseOff, maxOff, boost)
  local baseList = readQword(heroData + baseOff)
  local maxList = readQword(heroData + maxOff)
  if baseList and baseList ~= 0 then
    local items = readQword(baseList + 0x10)
    local size = readInteger(baseList + 0x18)
    for i = 0, (size or 0) - 1 do
      local cur = readFloat(items + 0x20 + i * 4) or 0
      writeFloat(items + 0x20 + i * 4, cur + boost)
    end
  end
  -- Also raise max caps so boosted stats aren't capped
  if maxList and maxList ~= 0 then
    local items = readQword(maxList + 0x10)
    local size = readInteger(maxList + 0x18)
    for i = 0, (size or 0) - 1 do
      local cur = readFloat(items + 0x20 + i * 4) or 0
      if cur < 50 + boost then writeFloat(items + 0x20 + i * 4, 50 + boost) end
    end
  end
end

local function postGenModify(heroData)
  if not heroData or heroData == 0 then return end
  local boost = tonumber(edtBoost.Text) or 0
  local newAge = tonumber(edtAge.Text) or 0
  local newLoyal = tonumber(edtLoyal.Text) or 0
  if boost > 0 then
    boostList(heroData, 0x128, 0x130, boost) -- attri base+max
    boostList(heroData, 0x140, 0x148, boost) -- fight base+max
    boostList(heroData, 0x158, 0x160, boost) -- living base+max
  end
  if newAge > 0 then writeInteger(heroData + 0xD4, newAge) end
  if newLoyal > 0 then writeFloat(heroData + 0x1CC, newLoyal) end
  -- Place hero at player's location
  local playerHero = _getHero()
  if playerHero then
    local playerArea = readInteger(playerHero + 0xC0)
    if playerArea and playerArea >= 0 then
      writeInteger(heroData + 0xC0, playerArea)
    end
  end
end

btnGenHero.OnClick = safeClick(function()
  if not S.ready then setStatus("请先连接游戏! [Connect first!]", 0x0000FF); return end
  local fid = readInteger(S.hero + 0x84) or 0
  local lv = cmbLv.ItemIndex
  local sex = cmbSex.ItemIndex
  setStatus("Generating...", 0x008080)
  local ok, msg = generateHero(fid, lv, sex)
  if ok then
    local heroData = readQword(getAddress("cmdBuf") + 0x08)
    postGenModify(heroData)
    setStatus(msg, 0x008000)
  else
    setStatus("ERR: " .. msg, 0x0000FF)
  end
end)

