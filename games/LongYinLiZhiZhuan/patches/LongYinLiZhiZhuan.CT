local input = InputQuery("Faction Contribution", "Set your contribution to ALL other factions to:", "999")
if not input then print("[OutContrib] Cancelled"); return end
local newVal = tonumber(input)
if not newVal then print("[OutContrib] Invalid number"); return end

local changed = 0
for i = 0, forceCount - 1 do
  local fd = readQword(forceItems + 0x20 + i * 8)
  if fd and fd ~= 0 then
    writeFloat(fd + 0x170, newVal * 1.0)
