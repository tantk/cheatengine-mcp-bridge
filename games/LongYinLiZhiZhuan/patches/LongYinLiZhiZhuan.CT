        <CheatEntry>
          <ID>50</ID>
          <Description>"--- Health ---"</Description>
          <GroupHeader>1</GroupHeader>
          <Color>008000</Color>
          <CheatEntries>
            <CheatEntry>
              <ID>900</ID>
              <Description>"Restore HP to Max"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end
local function getHero() return _getHero() end
local hero, err = getHero()
if not hero then error(err) end
