lbl = createLabel(frm); lbl.Left = 10; lbl.Top = Y; lbl.Caption = "Dungeon 副本"
lbl.Font.Size = 9; lbl.Font.Style = "fsBold"; Y = Y + 20
local btnFog = createButton(frm); btnFog.Left = 10; btnFog.Top = Y - 2; btnFog.Width = 200; btnFog.Height = 24
btnFog.Caption = "Reveal Map 揭示全图"
btnFog.OnClick = safeClick(function()
  if not S.ready then setStatus("请先连接游戏! [Connect first!]", 0x0000FF); return end
  local ok2, c2 = pcall(function()
    local c = _il2cppCache
    if c then
      local test = readBytes(getAddress("GameAssembly.dll"), 1)
      if not test then _il2cppCache = nil; _il2cpp_init(); c = _il2cppCache end
    else
      _il2cpp_init(); c = _il2cppCache
    end
    return c
  end)
  if not ok2 or not c2 then setStatus("ERR: il2cpp init failed", 0x0000FF); return end
  local ecClass = c2.findClass("ExploreController")
  if not ecClass then setStatus("ERR: ExploreController class not found", 0x0000FF); return end
  local ecStatic = readQword(ecClass + 0xB8)
  if not ecStatic or ecStatic == 0 then setStatus("ERR: ecStatic=0", 0x0000FF); return end
  local ecInst = readQword(ecStatic + 0x8)
  if not ecInst or ecInst == 0 then
    log(string.format("[Fog] ecClass=%X ecStatic=%X ecInst=%s", ecClass, ecStatic, tostring(ecInst)))
    setStatus("ERR: ExploreController instance null (ecStatic+8=0)", 0x0000FF)
    return
  end
  local inited = readBytes(ecInst + 0xD0, 1)
  if not inited or inited == 0 then
    log(string.format("[Fog] ecInst=%X inited=%s", ecInst, tostring(inited)))
    setStatus("ERR: dungeon not inited (ecInst+D0=0)", 0x0000FF)
    return
  end
  local seeAllAddr = _findMethodAddr(ecClass, "SeeAllTile", 0)
  if not seeAllAddr then setStatus("ERR: SeeAllTile not found", 0x0000FF); return end
  local cb = getAddress("cmdBuf")
  writeQword(cb + 0x08, ecInst)
  writeQword(cb + 0x68, seeAllAddr)
  writeInteger(cb + 0x04, 0)
  writeInteger(cb, 6)
  local elapsed = 0
  while elapsed < 2000 do
    if readInteger(cb + 0x04) ~= 0 then break end
    sleep(16); elapsed = elapsed + 16
  end
  setStatus("副本全图已揭示! [Map revealed!]", 0x008000)
end)

