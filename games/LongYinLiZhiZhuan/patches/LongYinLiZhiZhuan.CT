              </AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>501</ID>
              <Description>"Sect-Wide: Set Talent Points + Max Slots"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end

-- ============================================================
-- Sect-Wide Talent Editor
-- Finds all heroes in the player's sect, sets talent points
-- and patches GetMaxTagNum for higher slot limit.
-- ============================================================
local function getWorldData() return _getWorldData() end

local function readHeroName(hero)
  local np = readQword(hero + 0x68)
  if not np or np == 0 then return "?" end
  local nl = readInteger(np + 0x10)
  if not nl or (0 >= nl) or nl > 100 then return "?" end
  return readString(np + 0x14, nl * 2, true) or "?"
end

local wd, err = getWorldData()
if not wd then error(err) end

-- Get player hero (index 0)
local hl = readQword(wd + 0x50)
if not hl or hl == 0 then error("HerosList null") end
local heroCount = readInteger(hl + 0x18)
local itemsPtr = readQword(hl + 0x10)
if not itemsPtr or itemsPtr == 0 then error("HerosList items null") end

local playerHero = readQword(itemsPtr + 0x20)
if not playerHero or playerHero == 0 then error("Player hero null") end
local playerForceID = readInteger(playerHero + 0x84)
if not playerForceID then error("Cannot read player belongForceID") end

-- Collect all sect members
local sectMembers = {}
for i = 0, heroCount - 1 do
  local h = readQword(itemsPtr + 0x20 + i * 8)
  if h and h ~= 0 then
    local dead = readBytes(h + 0x61, 1)
    local fid = readInteger(h + 0x84)
    if fid == playerForceID and (dead == 0) then
      local name = readHeroName(h)
      local tp = readFloat(h + 0x35C)
      local tagList = readQword(h + 0x360)
      local tagCount = 0
      if tagList and tagList ~= 0 then tagCount = readInteger(tagList + 0x18) or 0 end
      local forceLv = readInteger(h + 0xB8) or 0
      table.insert(sectMembers, {ptr=h, name=name, tagPt=tp, tagCount=tagCount, forceLv=forceLv, idx=i})
    end
  end
end

if #sectMembers == 0 then error("No living sect members found (forceID=" .. playerForceID .. ")") end

-- Print sect roster to console
print("========== Sect Members (ForceID=" .. playerForceID .. ") ==========")
for _, m in ipairs(sectMembers) do
  print(string.format("  [%d] %s  ForceLv=%d  TalentPt=%.0f  Tags=%d",
    m.idx, m.name, m.forceLv, m.tagPt, m.tagCount))
end
print(string.format("  Total: %d members", #sectMembers))
print("=======================================================")

-- Ask for new talent points
local input = InputQuery("Sect Talent Points",
  #sectMembers .. " sect members found. Set ALL talent points to:", "99")
if not input then print("[SectTalent] Cancelled"); return end
local newPt = tonumber(input)
if not newPt then print("[SectTalent] Invalid number"); return end

-- Write talent points
_sectTalentOrigPts = {}
for _, m in ipairs(sectMembers) do
  _sectTalentOrigPts[m.ptr] = m.tagPt
  writeFloat(m.ptr + 0x35C, newPt * 1.0)
end
print(string.format("[SectTalent] Set %d members talent points to %.0f", #sectMembers, newPt))

-- Ask for max talent slots
local input2 = InputQuery("Max Talent Slots",
  "Set max talent slots to (all 3 return paths patched):", "99")
if input2 then
  local newCap = tonumber(input2)
  if newCap and newCap >= 1 and (255 >= newCap) then
    local c2 = _il2cpp_init()
    local targetAddr = _findMethodAddr(c2.hd.klass, "GetMaxTagNum")
    if not targetAddr or targetAddr == 0 then
      print("[SectTalent] ERROR: GetMaxTagNum method not found")
    else
      if true then
        print(string.format("[SectTalent] GetMaxTagNum at 0x%X — patching all return paths", targetAddr))
        -- GetMaxTagNum has 3 return paths, all ending with epilogue 48 83 C4 20 5B C3:
        --   mov eax, 0A (B8 0A ...) — hero+0x58 != 0 path
        --   mov eax, 09 (B8 09 ...) — config bool path
        --   add eax, 09 (83 C0 09) — calculated path
        _sectTalentCapPatches = {}
        local capByte = math.floor(newCap)
        for offset = 0, 511 do
          local b = readBytes(targetAddr + offset, 1)
          -- Pattern A: B8 XX 00 00 00 48 83 C4 20 5B C3
          if b == 0xB8 then
            local ok = true
            for ci, cv in ipairs({nil, 0x00, 0x00, 0x00, 0x48, 0x83, 0xC4, 0x20, 0x5B, 0xC3}) do
              if cv then
                if readBytes(targetAddr + offset + ci, 1) ~= cv then ok = false; break end
              end
            end
            if ok then
              local pAddr = targetAddr + offset + 1
              local orig = readBytes(pAddr, 1)
              table.insert(_sectTalentCapPatches, {addr=pAddr, orig=orig})
              writeBytes(pAddr, capByte)
              print(string.format("[SectTalent] Patched mov eax,0x%02X -> 0x%02X at +%d", orig, capByte, offset))
            end
          end
          -- Pattern B: 83 C0 XX 48 83 C4 20 5B C3
          if b == 0x83 and readBytes(targetAddr + offset + 1, 1) == 0xC0 then
            local ok = true
            for ci, cv in ipairs({nil, nil, nil, 0x48, 0x83, 0xC4, 0x20, 0x5B, 0xC3}) do
              if cv then
                if readBytes(targetAddr + offset + ci - 1, 1) ~= cv then ok = false; break end
              end
            end
            if ok then
              local pAddr = targetAddr + offset + 2
              local orig = readBytes(pAddr, 1)
              table.insert(_sectTalentCapPatches, {addr=pAddr, orig=orig})
              writeBytes(pAddr, capByte)
              print(string.format("[SectTalent] Patched add eax,0x%02X -> 0x%02X at +%d", orig, capByte, offset))
            end
          end
        end
        if #_sectTalentCapPatches == 0 then
          local dump = {}
          for i = 0, 31 do dump[#dump+1] = string.format("%02X", readBytes(targetAddr + i, 1) or 0) end
          print("[SectTalent] No patches found! First 32 bytes: " .. table.concat(dump, " "))
        else
          print(string.format("[SectTalent] Patched %d return paths (max slots = %d)", #_sectTalentCapPatches, newCap))
        end
      end
    end
  else
    print("[SectTalent] Skipped slot patch (cancelled or invalid)")
  end
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _sectTalentCapPatches then
  for _, p in ipairs(_sectTalentCapPatches) do
    writeBytes(p.addr, p.orig)
  end
  print(string.format("[SectTalent] Restored %d slot patches", #_sectTalentCapPatches))
  _sectTalentCapPatches = nil
end
print("[SectTalent] Disabled (talent points remain as set)")
{$asm}
              </AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>

        <CheatEntry>
