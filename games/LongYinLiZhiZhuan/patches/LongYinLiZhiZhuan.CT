[ENABLE]
{$lua}
if syntaxcheck then return end
local c = _il2cpp_init()
if not c:ensure("gd", "GlobalData") then error("GlobalData not loaded yet - try again") end
local listPtr = readQword(c.gd.static + c.gd.skillOff)
if not listPtr or listPtr == 0 then error("MaxSkillNum list not found") end
local count = readInteger(listPtr + 0x18)
local items = readQword(listPtr + 0x10)
_skillLimitOrig = {}
for i = 0, count - 1 do
  _skillLimitOrig[i] = readFloat(items + 0x20 + i * 4)
  writeFloat(items + 0x20 + i * 4, 99.0)
end
print(string.format("[SkillLimit] All %d tiers set to 99", count))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _skillLimitOrig then
  local ok, c = pcall(_il2cpp_init)
  if ok and c then
    if not c:ensure("gd", "GlobalData") then error("GlobalData not loaded yet - try again") end
local listPtr = readQword(c.gd.static + c.gd.skillOff)
    if listPtr and listPtr ~= 0 then
      local items = readQword(listPtr + 0x10)
      if items and items ~= 0 then
        for i, v in pairs(_skillLimitOrig) do
          writeFloat(items + 0x20 + i * 4, v)
        end
      end
    end
  end
  print("[SkillLimit] Restored original limits")
  _skillLimitOrig = nil
end
{$asm}
