        <CheatEntry>
          <ID>60</ID>
          <Description>"--- 战斗 [Battle] ---"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <GroupHeader>1</GroupHeader>
          <Color>008000</Color>
          <CheatEntries>
            <CheatEntry>
              <ID>1001</ID>
              <Description>"战斗加速 [Battle Speed]"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
local input = InputQuery("Battle Speed", "Enter speed (game max=10, try 200-500, max 999):", "50")
if not input then print("[Battle] Cancelled"); return end
local val = tonumber(input) or 50
if val > 999 then val = 999 end
if val < 1 then val = 1 end
_battleSpeedVal = val

-- Timer continuously forces the value since game overwrites it each frame
if _battleSpeedTimer then _battleSpeedTimer.destroy() end
_battleSpeedTimer = createTimer(nil)
_battleSpeedTimer.Interval = 50
_battleSpeedTimer.OnTimer = function()
  local pid = getOpenedProcessID()
  if not pid or pid == 0 then
    _battleSpeedTimer.Enabled = false
    return
  end
  local ok, wd = pcall(_getWorldData)
  if ok and wd then
    pcall(writeFloat, wd + 0x1D0, _battleSpeedVal)
  end
end
_battleSpeedTimer.Enabled = true
print(string.format("[Battle] Speed locked to %.0fx", val))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _battleSpeedTimer then
  _battleSpeedTimer.destroy()
  _battleSpeedTimer = nil
end
local ok, wd = pcall(_getWorldData)
if ok and wd then writeFloat(wd + 0x1D0, 1.0) end
print("[Battle] Speed timer stopped, restored to 1x")
{$asm}
]]></AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1000</ID>
              <Description>"一击必杀 [One-Hit KO]"</Description>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end
local c = _il2cpp_init()
if not c:ensure("bc", "BattleController", 0x50) then error("BattleController not loaded - enter a battle first") end
local bcInstance = readQword(c.bc.static + c.bc.instOff)
if not bcInstance or bcInstance == 0 then error("Not in battle (BattleController._instance null)") end
local playerUnit = readQword(bcInstance + 0x1A8)
if not playerUnit or playerUnit == 0 then error("Player unit not found") end
local pTeam = readQword(playerUnit + 0x58)
if not pTeam or pTeam == 0 then error("Player team null") end
local playerTeamID = readInteger(pTeam + 0x10)
local teams = readQword(bcInstance + 0x70)
if not teams or teams == 0 then error("Teams list null") end
local teamItems = readQword(teams + 0x10)
if not teamItems or teamItems == 0 then error("Team items null") end
local teamCount = readInteger(teams + 0x18)
local killed = 0
for t = 0, teamCount - 1 do
  local team = readQword(teamItems + 0x20 + t * 8)
  if team and team ~= 0 then
    local teamID = readInteger(team + 0x10)
    if teamID ~= playerTeamID then
      local units = readQword(team + 0x18)
      if units and units ~= 0 then
        local unitCount = readInteger(units + 0x18)
        local unitItems = readQword(units + 0x10)
        if unitItems and unitItems ~= 0 then
          for u = 0, unitCount - 1 do
            local unit = readQword(unitItems + 0x20 + u * 8)
            if unit and unit ~= 0 then
              local heroData = readQword(unit + 0x40)
              if heroData and heroData ~= 0 then
                local hp = readFloat(heroData + 0x178)
                if hp > 0 then
                  writeFloat(heroData + 0x178, 1.0)
                  killed = killed + 1
                end
              end
            end
          end
        end
      end
    end
  end
end
print(string.format("[Battle] Set %d enemies to 1 HP", killed))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
print("[Battle] (toggle again to use in next fight)")
{$asm}
              </AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>

